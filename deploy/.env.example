# SPDX-License-Identifier: AGPL-3.0-or-later
# Configuración de PRODUCCIÓN de vibe-gambling (https://vibe.aimar.dev).
#
#   cp deploy/.env.example deploy/.env   # y rellena lo marcado con «CAMBIA»
#
# docker-compose.yml lee este archivo dos veces: para interpolar el propio compose (puertos,
# imagen, contraseña de Postgres) y como `env_file` del servidor. El servidor valida TODAS las
# variables con zod al arrancar: si falta alguna o tiene un valor raro, no arranca y dice cuál.
# Nada de esto es secreto salvo POSTGRES_PASSWORD (y el .env nunca se sube al repo).
# Duraciones: los nombres acaban en _MS (milisegundos) o _SECONDS (segundos).

# ---------------------------------------------------------------- imagen y Docker

# Etiqueta de ghcr.io/aimarmndz/vibe-gambling a desplegar (el workflow deploy.yml la sobrescribe).
IMAGE_TAG=latest
# Subred de la red de Docker del compose (fija, para poder confiar en el proxy; ver TRUST_PROXY_CIDRS).
DOCKER_SUBNET=172.29.0.0/24

# ---------------------------------------------------------------- servidor

# URL pública (origen, sin barra final). Es el único origen aceptado en el WebSocket y en las
# peticiones con cookie, y la base de los enlaces /play?code=…
PUBLIC_URL=https://vibe.aimar.dev
# Orígenes extra permitidos (separados por comas). Solo para desarrollo con Vite; en producción vacío.
EXTRA_ALLOWED_ORIGINS=
# Interfaz y puerto DENTRO del contenedor. Fuera, el compose lo publica solo en 127.0.0.1:${PORT}.
HOST=0.0.0.0
PORT=8787
# Nombre de la instancia (sale en /api/meta y en la web) y si es la oficial.
INSTANCE_NAME=vibe-gambling
IS_OFFICIAL=true
# Nivel de log de pino: fatal | error | warn | info | debug | trace | silent. Los logs nunca
# llevan IPs, cabeceras, tokens ni queries.
LOG_LEVEL=info
# Tamaño máximo del cuerpo de una petición HTTP (bytes).
BODY_LIMIT_BYTES=16384
# Tiempo máximo del apagado ordenado (SIGTERM) antes de forzar la salida.
SHUTDOWN_TIMEOUT_MS=10000

# ---------------------------------------------------------------- base de datos

# Credenciales de Postgres (el contenedor las usa al crear la base de datos la primera vez).
POSTGRES_USER=vibe
POSTGRES_DB=vibe
# CAMBIA: contraseña larga y solo con caracteres seguros en URL, p. ej. `openssl rand -hex 32`.
POSTGRES_PASSWORD=CAMBIA-ESTO-openssl-rand-hex-32
# DATABASE_URL la compone docker-compose.yml a partir de las tres anteriores
# (postgres://USER:PASSWORD@postgres:5432/DB). Fuera de Docker, defínela aquí:
# DATABASE_URL=postgres://vibe:password@localhost:5432/vibe
# Conexiones máximas del pool y timeout de conexión.
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_SECONDS=10
# Aplicar las migraciones pendientes al arrancar (con cerrojo consultivo). Si pones false,
# ejecútalas a mano: docker compose run --rm server node dist/migrate.js
MIGRATE_ON_START=true
# Rutas DENTRO de la imagen (no las cambies salvo que montes otros archivos).
MIGRATIONS_DIR=/app/drizzle
WEB_DIST_DIR=/app/web
GAME_CONFIG_PATH=/app/config/game.json
SITE_CONFIG_PATH=/app/config/site.json

# ---------------------------------------------------------------- GitHub (Device Flow)

# CAMBIA: Client ID de la OAuth App de GitHub con «Enable Device Flow» activado (no es secreto;
# el Device Flow no usa client secret). Ver docs/DESPLIEGUE.md.
GITHUB_CLIENT_ID=Ov23liXXXXXXXXXXXXXX
# URLs de GitHub (configurables para apuntar a un GitHub falso en desarrollo y tests).
GITHUB_OAUTH_BASE_URL=https://github.com
GITHUB_API_BASE_URL=https://api.github.com
# Base de los enlaces a los perfiles (https://github.com/<login>).
GITHUB_WEB_BASE_URL=https://github.com
# Timeout de cada llamada a GitHub.
GITHUB_TIMEOUT_MS=5000
# Margen para aceptar un poll del mod un poco antes del intervalo de GitHub (jitter de red).
DEVICE_POLL_LEEWAY_MS=500

# ---------------------------------------------------------------- web y estáticos

# Caché de los archivos sin hash (favicon, imágenes OG…) y de /config.json (s).
STATIC_MAX_AGE_SECONDS=300
# Caché de /assets/* (llevan hash en el nombre: se pueden cachear un año).
ASSETS_MAX_AGE_SECONDS=31536000
# Orígenes extra permitidos en img-src de la CSP (avatares de GitHub del ranking).
CSP_IMG_ORIGINS=https://avatars.githubusercontent.com
# Duración de HSTS en segundos (solo se manda si PUBLIC_URL es https). 0 la desactiva.
HSTS_MAX_AGE_SECONDS=31536000

# ---------------------------------------------------------------- sesiones

# Nombre de la cookie de sesión de la web. El prefijo __Host- obliga a Secure, Path=/ y sin Domain.
SESSION_COOKIE_NAME=__Host-vibe_session
# Duración de la sesión de la web (cookie) y de la del mod.
WEB_SESSION_TTL_SECONDS=2592000
MOD_SESSION_TTL_SECONDS=31536000
# Cada cuánto, como mucho, se actualiza `last_used_at` de una sesión.
SESSION_TOUCH_INTERVAL_SECONDS=300
# Vida del enlace de un solo uso que abre la ventana.
LINK_CODE_TTL_SECONDS=60

# ---------------------------------------------------------------- IP real y rate limit

# Rangos (CIDR, separados por comas) desde los que se acepta la cabecera REAL_IP_HEADER.
# Vacío = se usa siempre la IP de la conexión. En la VPS el servidor recibe las conexiones del
# reverse proxy del host a través de la red de Docker, así que se confía en DOCKER_SUBNET; el
# firewall (deploy/cloudflare-firewall.sh) garantiza que a ese proxy solo llega Cloudflare, que es
# quien pone CF-Connecting-IP. Si el servidor recibiera directamente de Cloudflare, aquí irían
# los rangos de https://www.cloudflare.com/ips/.
TRUST_PROXY_CIDRS=172.29.0.0/24
# Cabecera con la IP real del cliente (Cloudflare: CF-Connecting-IP; Caddy propio: X-Real-IP).
REAL_IP_HEADER=CF-Connecting-IP
# Rate limit de /api: por IP real y, aparte, por token de sesión (peticiones por ventana).
RATE_LIMIT_IP_MAX=300
RATE_LIMIT_IP_WINDOW_MS=60000
# Las IPv6 cuentan por prefijo (cada casa recibe al menos un /64 y podría estrenar una
# dirección por petición). 64 es lo habitual; 128 = por dirección suelta.
RATE_LIMIT_IPV6_PREFIX=64
RATE_LIMIT_TOKEN_MAX=120
RATE_LIMIT_TOKEN_WINDOW_MS=60000

# ---------------------------------------------------------------- WebSocket

# Ping del servidor (Cloudflare corta los WebSockets con 100 s sin tráfico).
WS_PING_INTERVAL_MS=30000
# Ventanas abiertas a la vez por usuario.
WS_MAX_CONNECTIONS_PER_USER=3
# Tamaño máximo de un mensaje de la ventana (bytes); más grande = cierre 1009.
WS_MAX_MESSAGE_BYTES=4096
# Mensajes máximos de una ventana por intervalo.
WS_RATE_LIMIT_MAX=60
WS_RATE_LIMIT_WINDOW_MS=10000

# ---------------------------------------------------------------- temporadas

# Cada cuánto se comprueba si hay que cerrar la temporada (y se limpian códigos y sesiones caducados).
SEASON_CHECK_INTERVAL_MS=60000

# ---------------------------------------------------------------- copias de seguridad (backup.sh)

# Carpeta del host donde backup.sh deja los volcados y cuántos días se guardan.
# BACKUP_KEEP_DAYS tiene que coincidir con `instance.backupRetentionDays` de config/site.json, que
# es lo que la página /privacy dice (el servidor no lee esta variable: solo la usa backup.sh).
BACKUP_DIR=/var/backups/vibe-gambling
BACKUP_KEEP_DAYS=14

# ---------------------------------------------------------------- solo con docker-compose.caddy.yml

# Dirección del sitio para el Caddy propio (self-host en una máquina vacía, sin Cloudflare).
SITE_ADDRESS=vibe.example.com
