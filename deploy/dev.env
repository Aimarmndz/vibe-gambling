# SPDX-License-Identifier: AGPL-3.0-or-later
# Entorno de DESARROLLO (versionado a propósito: no hay secretos, solo valores locales).
# Lo usan `pnpm --filter @vibe-gambling/server dev` (desde el host) y docker-compose.dev.yml
# (que sobrescribe lo que cambia dentro de Docker: hosts, rutas y DATABASE_URL).
# Producción: ver deploy/.env.example.

PUBLIC_URL=http://localhost:8787
# Vite (5173) hace de proxy de /api y /ws: su origen también vale en desarrollo.
EXTRA_ALLOWED_ORIGINS=http://localhost:5173
HOST=127.0.0.1
PORT=8787

DATABASE_URL=postgres://vibe:vibe-dev-password@localhost:5436/vibe
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_SECONDS=10
MIGRATE_ON_START=true
MIGRATIONS_DIR=./drizzle

GITHUB_CLIENT_ID=fake-dev-client-id
GITHUB_OAUTH_BASE_URL=http://localhost:8788
GITHUB_API_BASE_URL=http://localhost:8788
GITHUB_WEB_BASE_URL=http://localhost:8788
GITHUB_TIMEOUT_MS=5000

INSTANCE_NAME=vibe-gambling (dev)
IS_OFFICIAL=false

WEB_DIST_DIR=../web/dist
STATIC_MAX_AGE_SECONDS=60
ASSETS_MAX_AGE_SECONDS=31536000
GAME_CONFIG_PATH=../../config/game.json
SITE_CONFIG_PATH=../../config/site.json
CSP_IMG_ORIGINS=http://localhost:8788
# Sin efecto en http://localhost (HSTS solo se manda con HTTPS).
HSTS_MAX_AGE_SECONDS=31536000

SESSION_COOKIE_NAME=vibe_session
WEB_SESSION_TTL_SECONDS=2592000
MOD_SESSION_TTL_SECONDS=31536000
SESSION_TOUCH_INTERVAL_SECONDS=300
LINK_CODE_TTL_SECONDS=60
DEVICE_POLL_LEEWAY_MS=500

TRUST_PROXY_CIDRS=
REAL_IP_HEADER=CF-Connecting-IP
RATE_LIMIT_IP_MAX=600
RATE_LIMIT_IP_WINDOW_MS=60000
RATE_LIMIT_IPV6_PREFIX=64
RATE_LIMIT_TOKEN_MAX=300
RATE_LIMIT_TOKEN_WINDOW_MS=60000
RATE_LIMIT_MAX_KEYS=5000

WS_PING_INTERVAL_MS=30000
WS_MAX_CONNECTIONS_PER_USER=3
WS_MAX_MESSAGE_BYTES=4096
WS_RATE_LIMIT_MAX=60
WS_RATE_LIMIT_WINDOW_MS=10000

BODY_LIMIT_BYTES=16384
SEASON_CHECK_INTERVAL_MS=60000
SHUTDOWN_TIMEOUT_MS=10000
LOG_LEVEL=info

# GitHub falso (solo desarrollo)
FAKE_GITHUB_HOST=127.0.0.1
FAKE_GITHUB_PORT=8788
FAKE_GITHUB_PUBLIC_URL=http://localhost:8788
FAKE_GITHUB_CLIENT_ID=fake-dev-client-id
FAKE_GITHUB_USER_ID=424242
FAKE_GITHUB_USER_LOGIN=octo-gambler
# Fecha de creación de la cuenta falsa en GitHub. Antigua: sale en el ranking. Pon una de hace
# menos de leaderboard.minAccountAgeDays (config/game.json) para ver el aviso de cuenta nueva.
FAKE_GITHUB_USER_CREATED_AT=2015-06-01T00:00:00Z
FAKE_GITHUB_INTERVAL_SECONDS=1
FAKE_GITHUB_EXPIRES_IN_SECONDS=900
