{
  "name": "@vibe-gambling/server",
  "version": "0.3.1",
  "private": true,
  "description": "Servidor de vibe-gambling: API HTTP, WebSocket, Device Flow de GitHub, temporadas y estáticos de la web.",
  "license": "AGPL-3.0-or-later",
  "author": "Aimar (https://github.com/Aimarmndz)",
  "homepage": "https://vibe.aimar.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aimarmndz/vibe-gambling.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/Aimarmndz/vibe-gambling/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "node build.ts",
    "dev": "tsx watch --env-file-if-exists=../../deploy/dev.env src/main.ts",
    "dev:fake-github": "tsx watch --env-file-if-exists=../../deploy/dev.env src/fake-github/main.ts",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx --env-file-if-exists=../../deploy/dev.env src/migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@vibe-gambling/shared": "workspace:*",
    "drizzle-orm": "~0.45.4",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "~0.31.11",
    "esbuild": "^0.28.2",
    "msw": "^3.0.3",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}
