# Variables del E2E con Claude Code real y de la grabación de los GIF (sin secretos).
# Apuntan a la pila de desarrollo de deploy/docker-compose.dev.yml.
E2E_BASE_URL=http://localhost:8787
E2E_COMPOSE_FILE=deploy/docker-compose.dev.yml
E2E_CLAUDE_BIN=claude
E2E_SCREENSHOT=docs/screenshots/e2e-claude-turn.png
E2E_MAX_EXTRA_MS=3000
E2E_PENDING_TURNS=3
E2E_PENDING_PROMPT=Responde solo con la palabra: hola
E2E_PENDING_SCREENSHOT=docs/screenshots/e2e-claude-pending.png
# GIF de las animaciones de espectáculo (pnpm fx:record): web a grabar (modo demo), salidas y tamaño.
FX_BASE_URL=http://localhost:8787
FX_GIF_MEGA=docs/fx-megawin.gif
FX_GIF_BANK=docs/fx-bank.gif
FX_GIF_WIDTH=320
FX_GIF_FPS=12
FX_GIF_MAX_BYTES=3145728
# GIF principal del README (pnpm hero:record): sesión interactiva real de Claude Code (izquierda,
# reproducida en xterm.js desde los CDN) y la ventana del juego (derecha), con el mismo reloj.
HERO_PROMPT=What does packages/web/src/ui/brandMark.ts do? Reply in English, in one short sentence.
HERO_OUTPUT=docs/hero.gif
HERO_LANG=en
# Teclas de la ventana antes del turno: limpia el boleto, 50 a cuatro plenos (17, 20, 14, 18) y 100 al rojo.
HERO_BETS=c x ArrowRight x ArrowLeft ArrowLeft x ArrowUp ArrowRight x ArrowDown ArrowDown ArrowDown ArrowDown z x
HERO_WIDTH=960
HERO_FPS=10
HERO_TERM_COLS=64
HERO_TERM_ROWS=24
HERO_TERM_FONT=DejaVu Sans Mono, Noto Sans Mono, monospace, Noto Color Emoji
HERO_TERM_FONT_SIZE=12
HERO_XTERM_JS=https://cdnjs.cloudflare.com/ajax/libs/xterm/6.0.0/xterm.js
HERO_XTERM_CSS=https://cdnjs.cloudflare.com/ajax/libs/xterm/6.0.0/xterm.min.css
HERO_XTERM_UNICODE_JS=https://cdn.jsdelivr.net/npm/@xterm/addon-unicode11@0.9.0/lib/addon-unicode11.js
HERO_KEY_DELAY_MS=55
HERO_LEAD_MS=1200
HERO_TAIL_MS=3500
HERO_SETTLE_MS=8000
HERO_LOOP_FADE_MS=600
HERO_RESULT_PATTERN=🎰\s*\d{1,2}\s*\S*\s*(red|black|green)
HERO_TITLE=A real Claude Code session (left) and the vibe-gambling window (right), same clock, no edits
HERO_TURN_TIMEOUT_MS=180000
HERO_COLORS=128
HERO_MAX_BYTES=5242880
