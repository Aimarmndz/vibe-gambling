# Variables de entorno de DESARROLLO de la web (Vite). La build de producción no usa ninguna:
# la configuración real llega en tiempo de ejecución desde /config.json (la sirve el servidor).
# Copia este archivo a `.env` y ajústalo.

# Puerto de Vite (5173 por defecto en este proyecto).
WEB_DEV_PORT=5173
# Servidor de vibe-gambling al que se reenvían /api, /ws y /config.json.
WEB_DEV_PROXY_TARGET=http://localhost:8787
# "1": Vite sirve /config.json desde config/*.json (útil para /play?demo sin servidor). "0": lo da el servidor.
WEB_DEV_LOCAL_CONFIG=0
# Nombre de la instancia en ese /config.json local (solo si WEB_DEV_LOCAL_CONFIG=1).
WEB_DEV_INSTANCE_NAME=vibe-gambling (dev)
