# Configuración de los tests E2E de la web (versionada: no hay secretos).
# Playwright arranca el servidor y el GitHub falso compilados (packages/server/dist) en estos
# puertos, distintos de los de desarrollo para no chocar con la pila de docker-compose.dev.yml.
E2E_SERVER_PORT=8797
E2E_FAKE_GITHUB_PORT=8798
# Base de datos si no hay DATABASE_URL en el entorno (en el CI la pone el job): una base aparte,
# vibe_e2e, en el Postgres del compose de desarrollo (no la de desarrollo: el ranking local no se
# llena de usuarios e2e-*). Se crea sola si no existe, conectándose a E2E_ADMIN_DATABASE.
E2E_DATABASE_URL=postgres://vibe:vibe-dev-password@localhost:5436/vibe_e2e
E2E_ADMIN_DATABASE=postgres
# Opcional (no se define aquí): E2E_WEBKIT_WS_ENDPOINT / E2E_FIREFOX_WS_ENDPOINT apuntan a un
# `playwright run-server` cuando el sistema no puede ejecutar ese navegador (WebKit en Arch). Ej.:
#   docker run --rm -d --network host --init mcr.microsoft.com/playwright:v1.64.0-noble \
#     /bin/sh -c "cd /tmp && npx -y playwright@1.64.0 run-server --port 3127 --host 127.0.0.1"
#   E2E_WEBKIT_WS_ENDPOINT=ws://127.0.0.1:3127/ pnpm --filter @vibe-gambling/web test:e2e
