# Configuración de los tests E2E de la web (versionada: no hay secretos).
# Playwright arranca el servidor y el GitHub falso compilados (packages/server/dist) en estos
# puertos, distintos de los de desarrollo para no chocar con la pila de docker-compose.dev.yml.
E2E_SERVER_PORT=8797
E2E_FAKE_GITHUB_PORT=8798
# Base de datos si no hay DATABASE_URL en el entorno (en el CI la pone el job): la del compose de desarrollo.
E2E_DATABASE_URL=postgres://vibe:vibe-dev-password@localhost:5436/vibe
